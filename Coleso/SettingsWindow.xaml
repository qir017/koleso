<Window x:Class="Coleso.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coleso — настройки"
        Width="980" Height="700" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#FF14161B" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD8D8D8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E2127"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="BorderBrush" Value="#FF3A3F4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#FF8AB4F8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF262B33"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="BorderBrush" Value="#FF3A3F4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF333A45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1B1F26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD8D8D8"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF191C22"/>
            <Setter Property="BorderBrush" Value="#FF2A2F38"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFD8D8D8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF262C36"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2E4A78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF191C22"/>
            <Setter Property="BorderBrush" Value="#FF2A2F38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFD8D8D8"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FF22262E"/>
            <Setter Property="Foreground" Value="#FFB8B8B8"/>
            <Setter Property="BorderBrush" Value="#FF2A2F38"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#FF8AB4F8"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1E2127"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="BorderBrush" Value="#FF3A3F4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" BorderThickness="1" CornerRadius="3"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  Opacity="0.75"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="content" Margin="10,0,26,0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding ItemTemplate}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border Background="#FF1E2127" BorderBrush="#FF3A3F4A" BorderThickness="1"
                                        CornerRadius="3" Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="content" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2E4A78"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2E4A78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- левая колонка: колёса -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Колёса" FontWeight="Bold" FontSize="15" Margin="2,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnAddWheel" Content="+ Добавить" Click="BtnAddWheel_Click" Padding="10,5"/>
                    <Button x:Name="btnDelWheel" Content="Удалить" Click="BtnDelWheel_Click" Margin="6,0,0,0" Padding="10,5"/>
                </StackPanel>
                <ListBox x:Name="lstWheels" SelectionChanged="LstWheels_SelectionChanged" DisplayMemberPath="Name"/>
            </DockPanel>

            <!-- правая колонка: редактор колеса -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Название колеса:" Width="130"/>
                    <TextBox x:Name="txtName" TextChanged="TxtName_TextChanged"/>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Тема колеса:" Width="130"
                               ToolTip="Оформление (цвета) именно этого колеса"/>
                    <ComboBox x:Name="cmbTheme" SelectionChanged="CmbTheme_SelectionChanged"
                              SelectedValuePath="Key"
                              ToolTip="Каждое колесо может быть в своей теме">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock x:Name="lblSectors" Text="Секторов: 8" Width="130"/>
                    <Slider x:Name="sldSectors" Minimum="4" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="SldSectors_ValueChanged"/>
                </DockPanel>

                <ListView x:Name="lstItems" Grid.Row="3" SelectionChanged="LstItems_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="№" Width="34" DisplayMemberBinding="{Binding Num}"/>
                            <GridViewColumn Header="Текст" Width="476" DisplayMemberBinding="{Binding Preview}"/>
                            <GridViewColumn Header="Картинка" Width="170" DisplayMemberBinding="{Binding Image}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Text="Текст выбранного сектора:" Margin="0,0,0,4" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtText" AcceptsReturn="True" TextWrapping="Wrap" Height="86"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             TextChanged="TxtText_TextChanged"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                   Text="Картинка сектора:"
                                   ToolTip="Если задана — при выборе сектора в приложение уйдёт картинка, а не текст"/>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBox x:Name="txtImage" TextChanged="TxtImage_TextChanged"
                                     ToolTip="Путь к изображению (png, jpg, bmp, gif) — либо вставьте картинку кнопкой «Из буфера»"/>
                            <TextBlock FontSize="11" Foreground="#FF8A8F98" Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Text="Картинка отправляется в приложение вместо текста; текст вставляется, только если картинки нет."/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Из буфера" Click="BtnImageFromClip_Click" Margin="0,0,6,0"
                                ToolTip="Скриншот, «Копировать картинку» из браузера, файл из Проводника — картинка сохранится и встанет сектором"/>
                        <Button Grid.Column="3" Content="Обзор…" Click="BtnImageBrowse_Click" Margin="0,0,6,0"/>
                        <Button Grid.Column="4" Content="✕" Click="BtnImageClear_Click"
                                ToolTip="Убрать картинку" Padding="10,6"/>
                        <Border Grid.Column="5" Width="66" Height="66" Margin="10,0,0,0"
                                Background="#FF14161B" BorderBrush="#FF3A3F4A" BorderThickness="1"
                                CornerRadius="4" VerticalAlignment="Top"
                                ToolTip="Превью картинки сектора">
                            <Image x:Name="imgPreview" Stretch="Uniform" Margin="4"/>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="↑ Выше" Click="BtnUp_Click"/>
                    <Button Content="↓ Ниже" Margin="6,0,0,0" Click="BtnDown_Click"/>
                    <Button Content="✕ Удалить сектор" Margin="6,0,0,0" Click="BtnDelItem_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- общие настройки -->
        <Border Grid.Row="1" Margin="0,12,0,0" Background="#FF191C22" BorderBrush="#FF2A2F38"
                BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Общие настройки" FontWeight="Bold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="chkAutoStart" Content="Запускать вместе с Windows"/>
                    <CheckBox x:Name="chkRestore" Content="Восстанавливать буфер обмена после вставки"/>
                    <CheckBox x:Name="chkHints" Content="Показывать подсказки на колесе"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,22,0,0">
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Размер колеса:" Width="120"/>
                        <Slider x:Name="sldSize" Minimum="150" Maximum="300" Value="210"
                                TickFrequency="10" IsSnapToTickEnabled="True"/>
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="Исключения СКМ:" Width="120"
                                   ToolTip="Процессы, где средний клик работает как обычно (через запятую)"/>
                        <TextBox x:Name="txtExcluded"
                                 ToolTip="Например: chrome.exe, firefox.exe"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnTest" Content="🎯 Показать колесо" Click="BtnTest_Click"/>
            <Button x:Name="btnReset" Content="Сбросить всё" Margin="8,0,0,0" Click="BtnReset_Click"/>
            <Button x:Name="btnSave" Content="Сохранить" Margin="8,0,0,0" FontWeight="Bold" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
